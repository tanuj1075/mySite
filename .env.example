# ==============================================================================
# VANTA E-COMMERCE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Database Connection (PostgreSQL with Prisma)
# In Node 18+ on Windows, prefer 127.0.0.1 instead of localhost to prevent IPv6 binding issues
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/vanta_archive?schema=public"

# Authentication Secrets (Generate secure random 64-char strings for production)
JWT_SECRET="replace_with_a_secure_jwt_access_secret_min_32_chars"
JWT_REFRESH_SECRET="replace_with_a_secure_jwt_refresh_secret_min_32_chars"

# Application URLs
CLIENT_URL="http://localhost:3000"
VITE_API_URL="http://localhost:4000/api"
PORT=4000

# ==============================================================================
# UPI PAYMENT PROVIDER SELECTION
# ==============================================================================
# UPI_PROVIDER options:
#   'hybrid'   → RECOMMENDED: Direct UPI VPA QR + Cashfree auto-webhook if KYC done
#   'cashfree' → Cashfree only (automatic webhooks, needs GSTIN + bank KYC)
#   'upipg'    → Direct UPI VPA only (manual UTR confirmation by customer)
UPI_PROVIDER="hybrid"

# ==============================================================================
# PART A: YOUR UPI VPA (Just a Bank Account — No KYC, No Registration)
# Works with ANY Indian bank account that has UPI enabled.
# QR code and upi:// links will show YOUR account as the payee.
# ==============================================================================
MERCHANT_UPI_ID="yourstore@okhdfcbank"   # Your UPI ID (from GPay/PhonePe/Paytm/bank app)
MERCHANT_UPI_NAME="YOUR STORE NAME"      # Name shown to customer during payment
UPI_PG_BASE_URL="https://upipg.cit.org.in"

# ==============================================================================
# PART B: CASHFREE (Automatic Verification — Needs Business KYC)
# When configured, Cashfree sends HMAC-SHA256 signed webhooks within 2-5 seconds
# after payment, automatically confirming orders without customer action.
# Register at: https://www.cashfree.com/
# Webhook Endpoint to register: https://<your-domain>/api/payments/webhook
# ==============================================================================
CASHFREE_APP_ID="your_cashfree_app_id"
CASHFREE_SECRET_KEY="your_cashfree_secret_key"
CASHFREE_ENV="sandbox"         # Use 'production' for live payments
CASHFREE_API_VERSION="2023-08-01"
