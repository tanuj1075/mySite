# AI Studio runtime configuration.
# AI Studio injects these values from user secrets when applicable.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Local full-stack API configuration.
DATABASE_URL="postgresql://postgres:password@localhost:5432/vanta_archive?schema=public"
JWT_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-refresh-secret"
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxx"
RAZORPAY_KEY_SECRET="replace-with-your-razorpay-secret"
RAZORPAY_WEBHOOK_SECRET="replace-with-the-secret-configured-in-razorpay-dashboard"
CLIENT_URL="http://localhost:3000"
VITE_API_URL="http://localhost:4000/api"
PORT="4000"
ADMIN_EMAIL="admin@vanta.com"
ADMIN_PASSWORD="replace-with-a-strong-admin-password"
