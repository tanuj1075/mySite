# ==============================================================================
# VANTA E-COMMERCE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Database Connection (PostgreSQL with Prisma)
# In Node 18+ on Windows, prefer 127.0.0.1 instead of localhost to prevent IPv6 binding issues
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/vanta_archive?schema=public"

# Authentication Secrets (Generate secure random 64-char strings for production)
JWT_SECRET="replace_with_a_secure_jwt_access_secret_min_32_chars"
JWT_REFRESH_SECRET="replace_with_a_secure_jwt_refresh_secret_min_32_chars"

# Application URLs
CLIENT_URL="http://localhost:3000"
VITE_API_URL="http://localhost:4000/api"
PORT=4000

# Initial Admin Credentials (for seed script)
ADMIN_EMAIL="admin@vanta.com"
ADMIN_PASSWORD="secure_admin_password_here"

# ==============================================================================
# UPI PAYMENT GATEWAY: CASHFREE PAYMENTS (NPCI P2M COMPLIANT)
# ==============================================================================
# Provider: Cashfree Payments (https://www.cashfree.com/)
# Fees: 0% MDR on UPI QR & Collect payments as mandated by RBI / NPCI
# Onboarding: Free instant merchant sandbox account; GSTIN + Bank Account for Production
# Webhook Endpoint to register in Cashfree Merchant Dashboard:
#   https://<your-domain>/api/payments/webhook
# Signature Algorithm: HMAC-SHA256 (Base64) over `${timestamp}${rawBody}`
CASHFREE_APP_ID="your_cashfree_app_id"
CASHFREE_SECRET_KEY="your_cashfree_secret_key"
CASHFREE_ENV="sandbox" # Use 'sandbox' for testing, 'production' for live payments
CASHFREE_API_VERSION="2023-08-01"
