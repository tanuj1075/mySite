generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum PaymentStatus {
  PENDING
  VERIFYING
  PAID
  FAILED
  REFUNDED
  COD
}

enum PaymentTransactionStatus {
  PENDING
  VERIFYING
  SUCCESS
  FAILED
  EXPIRED
  CANCELLED
  REVERSED
}

enum AuditActorType {
  SYSTEM
  WEBHOOK
  WORKER
  ADMIN
  USER
}


enum OrderStatus {
  ORDER_PLACED
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String
  phone        String?
  role         UserRole       @default(CUSTOMER)

  // Security, Lockout & MFA Controls
  failedLoginAttempts    Int       @default(0)
  lockedUntil            DateTime?
  mfaEnabled             Boolean   @default(false)
  mfaSecret              String?
  mfaBackupCodes         String[]  @default([])
  emailVerified          Boolean   @default(false)
  emailVerificationToken String?
  passwordResetToken     String?
  passwordResetExpires   DateTime?
  lastLoginAt            DateTime?
  lastLoginIp            String?

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  cart         Cart?
  addresses    Address[]
  orders       Order[]
  exchanges    ExchangeReturnRequest[]
  wishlistItems WishlistItem[]
  refreshTokens RefreshToken[]
  securityLogs  SecurityLog[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([userId])
}

model Product {
  id        String     @id
  sku       String     @unique
  name      String
  brand     String
  category  String
  price     Decimal    @db.Decimal(12, 2)
  mrp       Decimal    @db.Decimal(12, 2)
  isActive  Boolean    @default(true)
  catalog   Json
  cartItems CartItem[]
  orderItems OrderItem[]
  wishlistItems WishlistItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  @@index([brand, category])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model WishlistItem {
  id            String   @id @default(cuid())
  userId        String
  productId     String
  colorway      String
  specification String
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([userId, productId])
  @@index([userId, createdAt])
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  color     String
  size      String
  quantity  Int
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
  @@unique([cartId, productId, color, size])
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  name       String
  isPrimary  Boolean @default(false)
  tag        String?
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String
  country    String
  phone      String?
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique
  discountPercent Int
  minOrderValue   Decimal  @db.Decimal(12, 2)
  maxDiscount     Decimal? @db.Decimal(12, 2)
  description     String
  isActive        Boolean  @default(true)
}

model Order {
  id                String        @id @default(cuid())
  displayId         String        @unique
  userId            String
  addressSnapshot   Json
  subtotal          Decimal       @db.Decimal(12, 2)
  discount          Decimal       @db.Decimal(12, 2) @default(0)
  total             Decimal       @db.Decimal(12, 2)
  couponCode        String?
  paymentMethod     String
  paymentStatus     PaymentStatus @default(PENDING)
  paymentCurrency   String        @default("INR")
  paymentAmount     Decimal       @default(0) @db.Decimal(12, 3)
  exchangeRate      Decimal       @default(1) @db.Decimal(18, 8)
  orderStatus       OrderStatus   @default(ORDER_PLACED)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?
  trackingNumber    String?
  estimatedDeliveryMin DateTime?
  estimatedDeliveryMax DateTime?
  deliveryDaysMin   Int?
  deliveryDaysMax   Int?
  carrier           String        @default("VANTA Logistics")
  upiUtr            String?
  activePaymentId   String?
  payments          Payment[]
  items             OrderItem[]
  exchanges         ExchangeReturnRequest[]
  user              User          @relation(fields: [userId], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  @@index([userId, createdAt])
  @@index([upiUtr])
}

model SneakerDrop {
  id                  String   @id
  productId           String
  productName         String
  brand               String
  edition             String
  image               String
  price               Decimal  @db.Decimal(12, 2)
  mrp                 Decimal  @db.Decimal(12, 2)
  launchDate          String
  launchTime          String
  stock               Int
  status              String
  targetTimestamp     Float
  notifySubscribers   String[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ExchangeReturnRequest {
  id            String   @id @default(cuid())
  userId        String
  orderId       String
  type          String
  productId     String
  productName   String
  productImage  String
  currentSize   String
  requestedSize String?
  reason        String
  status        String   @default("Pending")
  adminNotes    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([orderId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  sku       String
  name      String
  brand     String
  color     String
  size      String
  price     Decimal @db.Decimal(12, 2)
  quantity  Int
  image     String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model Payment {
  id                    String                   @id @default(cuid())
  orderId               String
  order                 Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  attemptNumber         Int                      @default(1)
  provider              String                   @default("CASHFREE")
  merchantId            String?
  providerOrderId       String?
  providerPaymentId     String?                  @unique
  paymentSessionId      String?
  upiId                 String?
  upiUtr                String?
  paymentMethod         String                   @default("UPI_QR")
  amount                Decimal                  @db.Decimal(12, 2)
  amountReceived        Decimal?                 @db.Decimal(12, 2)
  currency              String                   @default("INR")
  status                PaymentTransactionStatus @default(PENDING)
  upiPaymentUrl         String?                  @db.Text
  qrCodeData            String?                  @db.Text
  expiresAt             DateTime?
  verifiedAt            DateTime?
  failedAt              DateTime?
  failureReason         String?
  verificationSource    String?
  metadata              Json?
  reconcileAttempts     Int                      @default(0)
  lastReconciledAt      DateTime?
  isLocked              Boolean                  @default(false)
  lockedAt              DateTime?
  auditLogs             PaymentAuditLog[]
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([upiUtr])
  @@index([providerOrderId])
}

model PaymentAuditLog {
  id          String         @id @default(cuid())
  paymentId   String
  payment     Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  fromStatus  String?
  toStatus    String
  action      String
  actorType   AuditActorType @default(SYSTEM)
  actorId     String?
  reason      String?
  metadata    Json?
  createdAt   DateTime       @default(now())

  @@index([paymentId])
  @@index([createdAt])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String    @unique
  eventType   String
  signature   String?
  payload     Json
  status      String    // PROCESSED, REJECTED, DUPLICATE, FAILED
  errorReason String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([provider, eventType])
  @@index([createdAt])
}

model SecurityLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventType   String   // LOGIN_SUCCESS, LOGIN_FAILED, ACCOUNT_LOCKED, MFA_SETUP, MFA_VERIFIED, MFA_FAILED, PASSWORD_RESET_REQ, PASSWORD_RESET_SUCCESS, LOGOUT, ADMIN_ACCESS_DENIED, SUSPICIOUS_REQUEST, RATE_LIMIT_EXCEEDED
  severity    String   @default("INFO") // INFO, WARN, CRITICAL
  ipAddress   String?
  userAgent   String?
  details     Json?
  createdAt   DateTime @default(now())

  @@index([userId, eventType])
  @@index([createdAt])
  @@index([eventType])
}